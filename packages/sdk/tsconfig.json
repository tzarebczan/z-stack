{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "customConditions": [
      "@z-stack/source"
    ]
  },
  "include": [
    "src/index.ts",
    "src/lab.ts",
    "src/vite.ts",
    "src/engine.ts",
    "src/constants.ts",
    "src/wasm-shim.d.ts",
    "src/services.ts",
    "src/native.ts",
    "src/engine-tools.ts",
    "src/hardware.ts",
    "src/storage.ts",
    "src/diagnostics.ts",
    "src/lab/adapter-conformance.ts"
  ]
}
