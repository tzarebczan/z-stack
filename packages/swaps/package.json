{
  "name": "@z-stack/swaps",
  "version": "0.1.0-alpha.12",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@z-stack/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt",
    "THIRD_PARTY_DEPENDENCIES.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs swaps",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/check-package.mjs swaps"
  },
  "dependencies": {
    "zod": "3.25.76",
    "@z-stack/solana": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
