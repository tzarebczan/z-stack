{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "ES2022.Intl",
      "DOM"
    ],
    "types": [],
    "skipLibCheck": true,
    "customConditions": [
      "@z-stack/source"
    ]
  },
  "include": [
    "src"
  ]
}
