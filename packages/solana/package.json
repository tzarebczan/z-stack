{
  "name": "@z-stack/solana",
  "version": "0.1.0-alpha.12",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@z-stack/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt",
    "THIRD_PARTY_DEPENDENCIES.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs solana",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/check-package.mjs solana"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.15",
    "@scure/bip39": "2.4.0",
    "micro-key-producer": "0.10.2",
    "@noble/curves": "2.0.1",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
